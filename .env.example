# Copy to .env for local development, and set the same variables in your
# host (e.g. Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# Postgres connection string (Neon dashboard → Connection string).
# Use a separate Neon branch for the deployed site.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# The same database without "-pooler" in the host: a direct connection,
# which Prisma migrations need (the pooler can't hold their lock).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Emails that can sign in as admin, comma-separated.
ADMIN_EMAILS="you@example.com"

# Email: set EITHER Gmail (free, ~500/day, sends from that Gmail address)
# OR Resend below. If both are set, Gmail is used.
# The app password comes from myaccount.google.com/apppasswords (needs
# 2-Step Verification on). Spaces in it are fine.
# GMAIL_USER="yourtutoring@gmail.com"
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# In development (npm run dev) emails are only printed to the terminal.
# Uncomment to really send them while developing.
# SEND_EMAILS_IN_DEV="true"

# Resend (resend.com/api-keys). Without a verified domain, Resend only
# delivers to the email the Resend account was created with.
RESEND_API_KEY="re_..."
# Sender, once your domain is verified in Resend.
EMAIL_FROM="TutorSpot <bookings@yourdomain.com>"

# Optional bot check on the booking form (Cloudflare Turnstile, free):
# dash.cloudflare.com → Turnstile → Add site → copy both keys. Off unless
# BOTH are set. (Cloudflare also has test keys for local development.)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
# TURNSTILE_SECRET_KEY="0x..."

# The site's public URL, used in emailed links (no trailing slash).
# Optional on Vercel: if unset, links use the project's production domain
# automatically. Set it for local development, or to force a custom domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional banner shown at the top of every page, e.g. on a test deployment.
# SITE_NOTICE="Test site: bookings aren't real and nothing is charged."

# Stripe (not used yet; payments come last).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
