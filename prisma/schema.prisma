// Prisma schema for the Tutoring Scheduling Platform
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The app connects through Neon's pooler (the "-pooler" host), which
  // handles many short-lived serverless connections well.
  url       = env("DATABASE_URL")
  // Migrations use a direct connection (same string without "-pooler"),
  // because the pooler can't hold the lock `prisma migrate deploy` takes.
  directUrl = env("DIRECT_URL")
}

enum SessionMode {
  online
  in_person
}

enum SessionStatus {
  pending_payment
  confirmed
  cancelled
  rescheduled
  completed
  no_show // the student didn't turn up (marked by the tutor or an admin)
}

model Tutor {
  id                     String   @id @default(cuid())
  name                   String
  email                  String   @unique
  phone                  String?
  onlineAvailable        Boolean  @default(true)
  inPersonAvailable      Boolean  @default(false)
  minBookingNoticeHours  Int      @default(24)
  maxBookingWindowHours  Int      @default(720) // 30 days
  // IANA timezone the tutor's weekly hours and exceptions are written in.
  timeZone               String   @default("America/Chicago")
  // Public profile, shown on the welcome page.
  // A small JPEG as a data URL (resized in the browser before upload), so no
  // separate image storage is needed.
  photo                  String?
  bio                    String?  @db.VarChar(500)
  // Where sessions happen. The in-person location is only a suggestion that
  // prefills the booking form (students choose where to meet); the meeting
  // link only goes to students who have booked.
  inPersonLocation       String?  @db.VarChar(200)
  meetingLink            String?  @db.VarChar(500)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  subjects               TutorSubject[]
  availabilityBlocks     AvailabilityBlock[]
  availabilityExceptions AvailabilityException[]
  sessions               Session[]
  bookingHolds           BookingHold[]
}

model Subject {
  id     String @id @default(cuid())
  name   String @unique

  tutors   TutorSubject[]
  sessions Session[]
}

model TutorSubject {
  tutorId   String
  subjectId String

  tutor   Tutor   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([tutorId, subjectId])
}

// Recurring weekly availability, e.g. "every Monday 3pm-6pm"
model AvailabilityBlock {
  id        String @id @default(cuid())
  tutorId   String
  dayOfWeek Int    // 0 = Sunday ... 6 = Saturday
  startTime String // "15:00" (HH:mm wall-clock time in the tutor's timeZone)
  endTime   String // "18:00"

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

// One-off override: either blocks out a normally-available slot,
// or opens up an extra slot outside the recurring schedule.
model AvailabilityException {
  id          String   @id @default(cuid())
  tutorId     String
  date        DateTime // the calendar date this applies to
  startTime   String
  endTime     String
  isAvailable Boolean  // true = extra availability, false = blackout

  tutor Tutor @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model Session {
  id           String        @id @default(cuid())
  tutorId      String
  subjectId    String

  studentName  String
  studentEmail String
  studentPhone String?
  description  String        @db.VarChar(1000)

  mode         SessionMode
  startAt      DateTime // real UTC instant
  endAt        DateTime
  timezone     String // the student's timezone when booking, used for their emails
  durationMin  Int
  priceCents   Int
  status       SessionStatus @default(pending_payment)

  // Stripe: the payment (refunds go against it), and the checkout this
  // session was paid in. Sessions booked together share a bookingRef; they
  // stay pending_payment, with BookingHolds on their times, until paid.
  stripePaymentIntentId String?
  bookingRef            String?
  // In-person sessions: where to meet, chosen by the student when booking
  // (prefilled with the tutor's usual spot). Null for online sessions.
  location     String?  @db.VarChar(200)
  // When the student ticked "I agree to the policies" while booking.
  policiesAcceptedAt    DateTime?
  cancellationToken     String  @unique @default(cuid())
  rescheduleToken       String  @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor   Tutor   @relation(fields: [tutorId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([tutorId, startAt, endAt])
  @@index([studentEmail, startAt, endAt])
  @@index([bookingRef])
}

// Temporary lock on a slot while a student is in Stripe Checkout,
// so two people can't pay for the same slot at once.
model BookingHold {
  id                     String   @id @default(cuid())
  tutorId                String
  startAt                DateTime
  endAt                  DateTime
  expiresAt              DateTime
  // The pending booking this slot is held for (Session.bookingRef).
  bookingRef             String

  tutor Tutor @relation(fields: [tutorId], references: [id])

  @@index([tutorId, startAt, endAt])
  @@index([bookingRef])
}

// ---------- Tutor/admin sign-in (emailed magic links) ----------
// Identity is just an email address: it signs in as the Tutor with that
// email, and/or as an admin if it's listed in ADMIN_EMAILS. Only SHA-256
// hashes of tokens are stored, so a database leak can't be replayed.

// One-time sign-in link, valid for a few minutes.
model LoginToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

// A signed-in browser. The cookie holds the raw token.
model AuthSession {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// A link emailed to a student so they can see all their bookings (the
// "My bookings" page). Reusable until it expires; only its hash is stored.
model BookingLookupToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// One row per rate-limited action (a booking, a sign-in email, ...), keyed
// like "book:ip:1.2.3.4". Counting recent rows enforces the limits across
// all of Vercel's servers. Old rows are pruned as new ones are added.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Site-wide settings, a single row (id 1), edited by admins.
model SiteSettings {
  id              Int      @id @default(1)
  // What every tutor charges per hour. Each session saves its own price
  // when booked, so changing this doesn't touch existing bookings.
  hourlyRateCents Int
  updatedAt       DateTime @updatedAt
}
